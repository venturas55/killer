<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="text-center mb-4">
                <img src="/img/imagenes/calavera.png" alt="">
            </div>

            <div class="text-center mb-4">
                <h2 class="fw-bold">Editar Partida {{partida.id_partida}}</h2>
                <p>{{partida.titulo}}</p>
            </div>

            <form action="/partidas/editgame/{{partida.id_partida}}" method="POST">
                <input type="hidden" value="{{partida.id_partida}}" name="id_partida">
                <input type="hidden" value="{{partida.status}}" name="status" >
                <div class="mb-4">
                    <div class="inputBox">
                        <input class="w-100" type="text" value="{{partida.titulo}}" name="titulo" required autofocus>
                        <span>Título</span>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="inputBox">
                        <input class="w-100" type="text" value="{{partida.descripcion}}" name="descripcion" required>
                        <span>Descripción</span>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="inputBox">
                        <input class="w-100" type="datetime-local"
                            value="{{formatearDateTimeInput partida.fecha_inicio}}" name="fecha_inicio" required>
                        <span>Fecha de inicio</span>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="inputBox">
                        <input class="w-100" type="datetime-local" value="{{formatearDateTimeInput partida.fecha_fin}}"
                            name="fecha_fin" required>
                        <span>Fecha de fin</span>
                    </div>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button class="btn btn-style btn-lg w-100">
                        Editar Partida
                    </button>
                    <a href="javascript:void(0)" onclick="history.back();" class="btn btn-secondary w-100">
                        Cancelar
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

