{{>logo}}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="text-center mb-4">
                <h2 class="fw-bold">Crear Nueva Partida</h2>
            </div>
            <form action="/partidas/add" method="POST">
                <div class="mb-4">
                    <div class="inputBox">
                        <input class="w-100" type="text" name="titulo" placeholder="Introduzca un título" required autofocus>
                        <span>Título</span>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="inputBox">
                        <input class="w-100" type="text" name="descripcion" placeholder="Introduzca una descripción">
                        <span>Descripción</span>
                    </div>
                </div>

                <div class="inputBox my-4 d-flex justify-content-center">
                    <div class="inputBox">
                        <input type="datetime-local" name="fecha_inicio" required>
                        <span>Fecha de inicio</span>
                    </div>
                </div>

                <div class="inputBox my-4 d-flex justify-content-center">
                    <div class="inputBox">
                        <input type="datetime-local" name="fecha_fin" required>
                        <span>Fecha de fin</span>
                    </div>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button class="btn btn-style btn-lg  text-center" style="display: flex; justify-content: center; align-items: center;">
                        Crear Nueva Partida
                    </button>
                    <a href="javascript:void(0)" onclick="history.back();" class="btn btn-secondary">
                        Atrás
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>