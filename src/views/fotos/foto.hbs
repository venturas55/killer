<!-- CUERPO -->
<div class="container py-4 mb-4">
  <div class="hazard-background mb-3"></div>

  <div class="row justify-content-center text-center">
    <div class="col-12 col-md-8">
      <h2 class="text-white">
        FOTO {{#if eliminado}} DE LA VÍCTIMA {{else}} DEL KILLER {{/if}}
      </h2>
      <p class="text-white mb-4">
        {{jugador.full_name}} - {{jugador.usuario}}
      </p>
      <div class="card shadow-sm mb-4">
        <img src="/img/profiles/{{jugador.pictureURL}}"
          alt="Foto {{#if eliminado}}de la víctima{{else}}del killer{{/if}}"
          class="card-img-top img-fluid rounded {{#if eliminado}}grayscale{{/if}}">
      </div>
      <a href="javascript:void(0)" onclick="history.back();" class="btn btn-warning btn-lg">
        Volver
      </a>
    </div>
  </div>
</div>