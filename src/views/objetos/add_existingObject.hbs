<div class="container p-4">
    <div class="row">
        <div class="col-md-4 mx-auto">
            <div class="card">
                <div class="card-body">
                    <h2>INTRODUCIR OBJETO</h2>
                    <select class="custom-select form-select form-select-sm" name="objecto" id="jugador"
                        aria-label=".form-select-sm example">
                        <option value=""> Selecciona</option>
                        {{#each objetos}}
                        <option value="{{this.id}}" data-nombre="{{this.nombre}}"
                            data-descripcion="{{this.descripcion}}" data-pictureURL="{{this.pictureURL}}">
                            {{this.nombre}} </option>
                        {{/each}}
                    </select>
                    <hr>


                    <form action="/partidas/{{id_partida}}/add_existing_object" method="POST" id="objectForm">
                        <div class="inputBox">
                            <input class="w-100 text-black" type="text" name="nombre" id="nombreInput" placeholder="Nombre"
                                readonly />
                            <span class="bg-white text-black">Item</span>
                        </div>
                        <div class="inputBox my-4">
                            <input class="w-100 text-black" type="text" name="descripcion" id="descripcionInput"
                                placeholder="Descripcion" readonly />
                            <span class="bg-white text-black">Descripción</span>
                        </div>
                        <div class="input-group">
                            <input type="hidden" name="tipo" value="objeto" />
                        </div>
                        <input type="hidden" name="pictureURL" value="{{objeto.pictureURL}}" id="pictureURLInput" />
                        {{#if objeto.pictureURL}}
                        <img src="/img/imagenes/{{objeto.pictureURL}}" class="w-100 m-2" alt="Sin imagen"
                            id="pictureURLPicture" />
                        {{else}}
                        <div class="d-flex justify-content-around">
                            <p class="text-muted"> Imagen no disponible</p>
                        </div>
                        {{/if}}
                        <div class="d-flex justify-content-around m-4">
                            <button class="btn btn-style btn-block">AÑADIR</button>

                        </div>
                        <div class="d-flex justify-content-around">
                            <p class="text-muted">Despues se puede modificar</p>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const select = document.getElementById('jugador');
        const nombreInput = document.getElementById('nombreInput');
        const descripcionInput = document.getElementById('descripcionInput');
        const pictureURLInput = document.getElementById('pictureURLInput');
        const pictureURLPicture = document.getElementById('pictureURLPicture');

        select.addEventListener('change', function () {
            const selectedOption = this.options[this.selectedIndex];

            // Update form fields
            nombreInput.value = selectedOption.dataset.nombre;
            descripcionInput.value = selectedOption.dataset.descripcion;
            pictureURLInput.value = selectedOption.dataset.pictureurl;

            // Update image preview
            //console.log(selectedOption.dataset);
            if (selectedOption.dataset.pictureurl) {
                pictureURLPicture.src = "/img/imagenes/" + selectedOption.dataset.pictureurl;
                pictureURLPicture.alt = "/img/imagenes/" + selectedOption.dataset.pictureurl;
            } else {
                pictureURLPicture.src = '';
            }

        });
    });
</script>