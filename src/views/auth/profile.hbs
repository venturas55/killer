{{>logo}}
<div class="container p-4">
    <div class="row4">
        <div class="col-md-10 mx-auto">
            <div class="card text-center text-dark">
                <div class="card-body my-2">
                    <h4>Bienvenid@ <strong> {{user.usuario}} </strong>!</h4>
                    {{>avatar}}
                    <form action="/profile/upload/{{user.id}}" method="POST" enctype="multipart/form-data">
                        <input type="hidden" name="user" value="{{user.id}}" />
                        <div class="text-dark mx-auto">
                            <div class="custom-file">
                                <input type="file" name="imagen" class="custom-file-input" id="inputGroupFile02">
                                <button type="submit" class="btn btn-warning">Upload</button>
                            </div>
                        </div>
                    </form>
                    <div class="card  my-2">
                        <p class="text-dark"> <strong> Id:</strong> {{user.id}} </p>
                        <p class="text-dark"><strong> Nombre: </strong>{{user.full_name}} </p>
                        <p class="text-dark"><strong> Usuario:</strong> {{user.usuario}} </p>
                        <p class="text-dark"><strong> Correo:</strong> {{user.email}} </p>
                        <p class="text-dark"><strong> Privilegio: </strong>{{user.privilegio}} </p>
                    </div>
                    <div class="d-grid gap-2 col-6 mx-auto my-3">
                        <a href="/profile/edit" class="btn btn-style mb-1 "> Editar el Perfil </a>
                        {{!-- <a href="/jugador/fotosjuego" class="btn btn-style mb-1">Actualizar fotos juego</a> --}}
                        {{!-- <a href="/profile/email/recordarpass" class="btn btn-style mb-1">Recordar contraseña</a>
                        --}}
                        <a href="/logout" class="btn btn-style mb-1">Logout</a>
                        <a href="/partidas/listar" class="btn btn-style mb-1">Partidas</a>
                    </div>
                    {{!-- <form action="/profile/delete/{{user.id}}" method="post">
                        <button type="submit" class="btn btn-outline-danger m-1">Eliminar Perfil</button>
                    </form> --}}
                    <!-- Botón para activar el modal de eliminación -->
                </div>
            </div>
        </div>
    </div>
</div>