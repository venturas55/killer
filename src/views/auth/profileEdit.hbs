{{>logo}}
<div class="container p-4">
  <div class="row justify-content-center">
    <div class="col-md-10 mx-auto">
      <div class="card text-center text-dark">
        <div class="card-body text-center p-5">

          <h3 class="mb-4">Editando tu perfil, @{{user.usuario}}</h3>
          <img src="/img/profiles/{{user.pictureURL}}" class="avatar avatar-l m-2" alt="avatar" />

          <form action="/profile/edit/" method="POST">
            <input type="hidden" name="id" value="{{user.id}}" />

            <div class="form-floating mb-3">
              <input type="text" value="{{user.full_name}}" name="full_name" class="form-control" />
              <label for="full_name">Nombre completo</label>
            </div>
            <div class="form-floating mb-3">
              <input type="text" value="{{user.usuario}}" name="usuario" class="form-control" />
              <label for="usuario">Usuario</label>
            </div>
            <div class="form-floating mb-3">
              <input type="text" value="{{user.email}}" name="email" class="form-control" />
              <label for="email">eMail</label>
            </div>


            <div class="d-grid gap-2 d-md-block text-center">
              <button class="btn btn-primary btn-sm">Guardar cambios</button>
              <a href="/profile" class="btn btn-outline-secondary btn-sm">Cancelar</a>
            </div>
            <div class="my-4 d-grid gap-2 d-md-block">
              <p class="text-black">Para cambiar la contraseña <span> <a href="/profile/changepass" class="">haz click aqui</a></span></p>
            </div>
          </form>
        
        </div>
      </div>
    </div>
  </div>
</div>